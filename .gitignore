# Root-level gitignore
# Each subfolder (backend/, frontend/) has its own .gitignore for fine-grained control

# Dependencies
node_modules/

# Environment variables (NEVER commit secrets)
.env
.env.*
.env.local
.env.*.local
.env.production
.env.development
*.env

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
bun-error.log*

# Build output
dist/
build/
.next/
out/

# Temporary files
*.tmp
*.temp

# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/
next.user-config.*